{
  "name": "opsx-schema",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nebuless/opsx-schema.git"
  },
  "type": "module",
  "files": [
    "src",
    "assets",
    "opsx-schema.json",
    "docs/commands.md",
    "docs/workflows.md",
    "LICENSE",
    "resources/LICENSE",
    "resources/README.md",
    "resources/CONTRIBUTING.md",
    "resources/openspec/schemas",
    "resources/.agents",
    "resources/.atomic",
    "resources/.claude",
    "resources/.codex",
    "resources/.omp",
    "resources/.opencode",
    "resources/.pi",
    "resources/.senpi"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "opsx-schema": "./src/domain/cli.ts"
  },
  "scripts": {
    "test": "bun run test:app && bun run test:schemas",
    "test:app": "bun run test:application && bun run test:distribution",
    "test:schemas": "sh resources/scripts/check-resources.sh",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run qlty:check && bun run typecheck && bun run test",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "qlty:check": "qlty --version | grep -q '^qlty 0.644.0 ' && qlty check --all --no-formatters && qlty smells --all --quiet --no-snippets",
    "commitlint": "commitlint --config commitlint.config.js",
    "commitlint:range": "commitlint --config commitlint.config.js",
    "changelog": "conventional-changelog --preset conventionalcommits",
    "test:application": "bun test test --timeout 30000 --path-ignore-patterns test/integration/distribution.test.ts",
    "test:distribution": "bun test test/integration/distribution.test.ts --timeout 120000"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "@toon-format/toon": "^4.1.1",
    "react": "^19.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-conventionalcommits": "9.0.0",
    "sigstore": "4.0.0",
    "typescript": "^7.0.2"
  }
}
